{
  "name": "buildcheck",
  "version": "0.1.0",
  "description": "Build planner and validator for Lorien Trust characters",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "divergence": "vitest run src/engine/plan.test.ts -t divergence --reporter=verbose",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesatu/BuildCheck.git"
  },
  "author": "AKScott",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jesatu/BuildCheck/issues"
  },
  "homepage": "https://github.com/jesatu/BuildCheck#readme",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true
}
